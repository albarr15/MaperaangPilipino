---
import "@/styles/global.css";
import MainLayout from "@/layouts/MainLayout.tsx";
import Mission from "@/components/sections/about/Mission.astro";
import Founder from "@/components/sections/about/Founder.astro";
import Recognition from "@/components/sections/about/Recognition.astro";
import "@/styles/starwind.css";
import Hero3 from "@/components/starwind-pro/hero-03/Hero3.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="theme-color" content="#ac1212" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/teamca-white-circle-logo.png" />
    <title>About | Team CA</title>
  </head>
  <body>
    <MainLayout client:load>
      <Hero3
        heading="Meet Your Financial Advisor"
        description="Ms. Christelle Ann de Leon is a financial advisor with Black Orcas Summit Life Insurance Agency, affiliated with Pru Life UK Philippines, recognized among the top 10% of advisors nationwide."
        primaryButtonText="Learn More"
        primaryButtonHref="mission"
        image={{
          src: "/images/about/514232313_1055033080065300_8905804245584125715_n.jpg",
          alt: "Ms. Christelle Ann De Leon, an expert financial advisor",
        }}
      />
      <Mission />
      <Founder />
      <Recognition />
    </MainLayout>
  </body>
</html>
