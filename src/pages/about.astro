---
import "@/styles/global.css";
import MainLayout from "@/layouts/MainLayout.astro";
import Mission from "@/components/sections/about/Mission.astro";
import Founder from "@/components/sections/about/Founder.astro";
import Recognition from "@/components/sections/about/Recognition.astro";
import "@/styles/starwind.css";
import Hero3 from "@/components/starwind-pro/hero-03/Hero3.astro";
import Education from "@/components/sections/about/Education.astro";
import CTA from "@/components/sections/home/CTA.astro";
import aboutHeroImage from "@/assets/images/home/ms-ann-1.jpg";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="theme-color" content="#ac1212" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Maperaang Pilipino" />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="black-translucent"
    />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/maperaang-pilipino.png" />
    <link rel="icon" type="image/png" href="/icons/maperaang-pilipino.png" />
    <title>About | Maperaang Pilipino</title>
  </head>
  <body>
    <MainLayout>
      <Hero3
        heading="Meet Your Financial Advisor"
        description="Every plan I build comes from understanding exactly what a family is trying to protect. Here's a bit more about who I am and how I got here."
        primaryButtonText="Learn More"
        primaryButtonHref="/about#founder"
        image={{
          src: aboutHeroImage,
          alt: "Christelle Ann De Leon, an expert financial advisor",
        }}
      />
      <Founder />
      <Mission />
      <Education />
      <Recognition />
      <CTA />
    </MainLayout>
  </body>
</html>
