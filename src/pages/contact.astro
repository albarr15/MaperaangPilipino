---
import "@/styles/global.css";
import MainLayout from "@/layouts/MainLayout.astro";
import ContactHero from "@/components/hero/ContactHero.tsx";
import ContactDetails from "@/components/sections/contact/ContactDetails.astro";
import ConsultationForm from "@/components/sections/appointment/Consultation.astro";
import { Toaster } from "@/components/starwind/toast";
import "@/styles/starwind.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="theme-color" content="#ac1212" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Maperaang Pilipino" />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="black-translucent"
    />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/teamca-white-circle-logo.png" />
    <link
      rel="icon"
      type="image/png"
      href="/icons/teamca-white-circle-logo.png"
    />
    <title>Contact Us | Maperaang Pilipino</title>
  </head>
  <body>
    <MainLayout>
      <ContactHero client:load />
      <ContactDetails />
      <ConsultationForm />
      <Toaster position="bottom-right" />
    </MainLayout>
  </body>
</html>
