---
import "@/styles/global.css";
import MainLayout from "@/layouts/MainLayout.tsx";
import WhatWeDo from "@/components/sections/home/WhatWeDo.astro";
import WhoWeAre from "@/components/sections/home/WhoWeAre.tsx";
import WhyFinancialMatters from "@/components/sections/home/WhyFinancialMatters.tsx";
import Testimonials from "@/components/sections/home/Testimonials.astro";
import CTA from "@/components/sections/home/CTA.tsx";
import CredentialsRow from "@/components/sections/home/CredentialsRow.astro";

import { ThemeInitScript } from "@starwind-ui/astro/theme";
import "@/styles/starwind.css";
import Hero3 from "@/components/starwind-pro/hero-03/Hero3.astro";
import HomeHero from "@/components/hero/HomeHero.astro";
---

<html lang="en">
  <head>
    <ThemeInitScript />
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="theme-color" content="#ac1212" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/teamca-white-circle-logo.png" />
    <title>Home | Team CA</title>
  </head>
  <body>
    <MainLayout client:load>
      <HomeHero />
      <WhoWeAre client:load />
      <WhatWeDo />
      <WhyFinancialMatters client:load />
      <Testimonials />
      <CTA client:load />
    </MainLayout>
  </body>
</html>
