---
import type { HTMLAttributes } from "astro/types";
import { tv } from "tailwind-variants";

import {
  Avatar,
  AvatarFallback,
  AvatarImage,
} from "@/components/starwind/avatar";
import { Card, CardContent } from "@/components/starwind/card";
import Button from "@/components/starwind/button/Button.astro";

/** Testimonial data */
export interface Testimonial {
  /** Person's name */
  name: string;
  /** Date of Testimonial */
  date: string;
  /** Testimonial content */
  content: string;
  /** Profile image URL */
  image?: string;
}

interface Props extends HTMLAttributes<"section"> {
  /** Section heading */
  heading?: string;
  /** Section description */
  description?: string;
  /** Array of testimonials */
  testimonials?: Testimonial[];
}

const testimonial3Styles = tv({
  base: "@container mx-auto w-full max-w-7xl px-4 py-24",
});

const {
  heading,
  description,
  testimonials = [],
  class: className,
  ...rest
} = Astro.props;
---

<section class={testimonial3Styles({ class: className })} {...rest}>
  <div class="mb-16 text-center">
    <h2
      class="font-heading text-3xl font-bold tracking-tight text-pretty @2xl:text-4xl"
    >
      {heading}
    </h2>
    <p class="text-muted-foreground mt-4 text-lg text-pretty">
      {description}
    </p>
  </div>

  <div
    class="grid gap-6 @xl:grid-cols-2 @3xl:grid-cols-3 @3xl:gap-8 items-start"
  >
    {
      testimonials.map((testimonial) => (
        <Card>
          <CardContent
            class="flex flex-col gap-4 min-h-[250px]"
            data-testimonial-card
          >
            <div class="flex items-center gap-4">
              <Avatar>
                {/* <AvatarImage src={testimonial.image} alt={testimonial.name} /> */}
                <AvatarFallback>{testimonial.name[0]}</AvatarFallback>
              </Avatar>
              <div>
                <div class="font-medium">{testimonial.name}</div>
                <div class="text-muted-foreground text-sm">
                  {testimonial.date}
                </div>
              </div>
            </div>
            <blockquote
              class="text-muted-foreground text-justify line-clamp-5"
              data-quote
            >
              "{testimonial.content}"
            </blockquote>
            <Button size="sm" variant="ghost" data-toggle-btn>
              Read More
            </Button>
          </CardContent>
        </Card>
      ))
    }
  </div>

  <script>
    document
      .querySelectorAll<HTMLElement>("[data-testimonial-card]")
      .forEach((card) => {
        const quote = card.querySelector<HTMLElement>("[data-quote]");
        const btn = card.querySelector<HTMLButtonElement>("[data-toggle-btn]");
        if (!quote || !btn) return;

        // Only show the button if the text actually overflows past the clamp
        const isOverflowing = quote.scrollHeight > quote.clientHeight;
        if (!isOverflowing) {
          btn.style.display = "none";
          return;
        }

        let expanded = false;
        btn.addEventListener("click", () => {
          expanded = !expanded;
          quote.classList.toggle("line-clamp-5", !expanded);
          btn.textContent = expanded ? "Read Less" : "Read More";
        });
      });
  </script>
</section>
