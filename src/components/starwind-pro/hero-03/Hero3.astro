---
import type { HTMLAttributes } from "astro/types";
import type { ImageMetadata } from "astro";
import { tv } from "tailwind-variants";

import { AspectRatio } from "@/components/starwind/aspect-ratio";

import Button from "@/components/starwind/button/Button.astro";
import { Image } from "astro:assets";
import circleGradientShade from "@/assets/images/circle-gradient-shade.png";

interface Props extends HTMLAttributes<"section"> {
  /** Main heading text */
  heading?: string;
  /** Description text */
  description?: string;
  /** Primary button text */
  primaryButtonText?: string;
  /** Primary button href */
  primaryButtonHref?: string;
  /** Secondary button text */
  secondaryButtonText?: string;
  /** Secondary button href */
  secondaryButtonHref?: string;
  /** Image configuration */
  image?: {
    src: ImageMetadata;
    alt: string;
  };
}

const hero3Styles = tv({
  base: "@container relative w-full overflow-hidden",
});

const {
  heading = "Transform Your Ideas Into Reality",
  description = "Powerful tools and components designed to help you build exceptional web experiences. Start creating today with our intuitive design system.",
  primaryButtonText = "Get Started Free",
  primaryButtonHref = "#",
  secondaryButtonText,
  secondaryButtonHref = "#",
  image = {
    src: "https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=800&auto=format&fit=crop&q=80",
    alt: "Analytics dashboard preview",
  },
  class: className,
  ...rest
} = Astro.props;
---

<section class={hero3Styles({ class: className })} {...rest}>
  <Image
    src={circleGradientShade}
    alt="circle gradient shade"
    class="absolute inset-0 w-full h-full object-cover z-0"
    widths={[640, 1024, 1536]}
    sizes="100vw"
    fetchpriority="high"
    loading="eager"
  />
  <div
    id="hero-container"
    class="mx-auto max-w-7xl px-6 sm:px-10 lg:px-16 pt-32 pb-24 relative z-10 grid gap-12 @2xl:grid-cols-2 @2xl:items-center @2xl:gap-16"
  >
    <div class="flex flex-col">
      <h1
        class="font-heading text-4xl font-semibold tracking-tight @4xl:text-5xl"
      >
        {heading}
      </h1>
      <p class="text-muted-foreground mt-6 text-lg">
        {description}
      </p>
      <div class="mt-8 flex flex-col flex-wrap gap-4 @md:flex-row">
        {
          primaryButtonText && (
            <Button href={primaryButtonHref}>{primaryButtonText}</Button>
          )
        }
        {
          secondaryButtonText && (
            <Button variant="outline" href={secondaryButtonHref}>
              {secondaryButtonText}
            </Button>
          )
        }
      </div>
    </div>
    <div class="">
      <AspectRatio ratio={4 / 3} class="overflow-hidden rounded-lg">
        {
          typeof image.src === "string" ? (
            <img
              src={image.src}
              alt={image.alt}
              class="size-full object-cover"
            />
          ) : (
            <Image
              src={image.src}
              alt={image.alt}
              class="size-full object-cover"
              widths={[480, 768, 1024]}
              sizes="(max-width: 768px) 100vw, 50vw"
              fetchpriority="high"
              loading="eager"
            />
          )
        }
      </AspectRatio>
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";

  const textEl = document.getElementById("hero-container");
  const sectionEl = textEl?.closest("section");

  if (textEl) {
    gsap.context(() => {
      gsap.from(textEl, {
        y: 50,
        opacity: 0,
        duration: 0.8,
        ease: "power3.out",
      });
    }, sectionEl || undefined);
  }
</script>
