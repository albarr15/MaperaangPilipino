---
import { Image } from "astro:assets";

const { beneficiary, index, class: className, ...rest } = Astro.props;
---

<div
    class="grid grid-cols-1 md:grid-cols-2 md:grid-rows-[minmax(0,1fr)] w-full gap-8"
>
    <div
        class:list={[
            "flex flex-col gap-4",
            index % 2 === 0 ? "order-1" : "order-1 md:order-2",
        ]}
    >
        <h2
            class="font-heading text-3xl font-semibold tracking-tight leading-tight @2xl:text-4xl"
        >
            {beneficiary.header}
        </h2>
        <p class="text-justify">
            {beneficiary.description}
        </p>
    </div>
    <Image
        src={beneficiary.image}
        alt={beneficiary.imageAlt}
        class:list={[
            "h-[300px] object-cover rounded-xl min-w-0 w-full",
            index % 2 === 0 ? "order-2" : "order-2 md:order-1",
        ]}
        widths={[480, 768, 1024]}
        sizes="(max-width: 768px) 100vw, 50vw"
    />
</div>
