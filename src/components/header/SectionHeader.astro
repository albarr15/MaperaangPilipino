---
import { tv } from "tailwind-variants";

interface Props {
  heading?: string | null;
  description?: string | null;
  class?: string;
  variant?: "primary" | "white" | "black";
}

// TODO: finish new styles
const headerStyles = tv({
  base: "w-full py-20 px-6 md:px-12 lg:px-20 flex flex-col",
  variants: {
    variant: {
      default: "",
      primary: "bg-primary/80",
    },
  },
});

const { heading, description, class: className, ...rest } = Astro.props;
---

<div class={`mx-auto max-w-5xl text-center mb-16 ${className}`} {...rest}>
  <h2
    class="fade-up text-primary mt-4 text-balance text-3xl font-semibold tracking-tight lg:text-4xl xl:text-5xl"
  >
    {heading}
  </h2>
  <p class="fade-up text-muted-foreground mt-4 text-pretty lg:text-lg">
    {description}
  </p>
</div>
