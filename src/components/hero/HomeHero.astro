---
import Hero3 from "../starwind-pro/hero-03/Hero3.astro";
import CredentialsRow from "../sections/home/CredentialsRow.astro";
import homeHeroImage from "@/assets/images/about/514232313_1055033080065300_8905804245584125715_n.jpg";
---

<section class="w-full">
    <Hero3
        heading="Financial Advisor with a Heart"
        description="Hi I'm Ann De Leon, a licensed financial advisor with Black Orcas Summit Life Insurance Agency, affiliated with Pru Life UK Philippines. I help Filipino families protect the people they love and build a lasting legacy, one honest plan at a time."
        primaryButtonText="Book a Consultation"
        primaryButtonHref="/consultation"
        secondaryButtonText="Message Me"
        secondaryButtonHref="https://www.facebook.com/MaperaangPilipino"
        image={{
            src: homeHeroImage,
            alt: "Ms. Christelle Ann De Leon, an expert financial advisor",
        }}
    />
    <CredentialsRow layout="row" />
</section>
