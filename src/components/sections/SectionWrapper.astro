---
import { tv } from "tailwind-variants";

interface Props {
    variant?: "default" | "primary";
    class?: string;
}

const wrapperStyles = tv({
    base: "w-full py-20 px-6 md:px-12 lg:px-20 flex flex-col",
    variants: {
        variant: {
            default: "",
            primary: "bg-primary/8",
        },
    },
});

const { variant = "default", class: className, ...rest } = Astro.props;
---

<section class={wrapperStyles({ variant, class: className })}>
    <div class="w-full max-w-7xl mx-auto">
        <slot />
    </div>
</section>

