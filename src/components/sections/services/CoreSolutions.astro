---
import SectionHeader from "@/components/header/SectionHeader.astro";
import Button from "@/components/starwind/button/Button.astro";
import { Image } from "astro:assets";

import personalImg from "@/assets/images/services/national-cancer-institute-xDSD3Vmzh70-unsplash.jpg";
import corporateImg from "@/assets/images/services/photo-1508385082359-f38ae991e8f2.avif";

const solutions = [
    {
        btnId: "personalBtn",
        title: "Personal / Individual Insurance",
        description:
            "Protect your family's future with life insurance, income protection, critical illness coverage, retirement planning, and more.",
        image: personalImg,
        href: "/services#personal-insurance",
    },
    {
        btnId: "corporateBtn",
        title: "Organization / Corporate Insurance",
        description:
            "Safeguard your business with employee benefits, executive protection, keyman insurance, and corporate investment strategies.",
        image: corporateImg,
        href: "/services#corporate-insurance",
    },
];
---

<section
    id="core-solutions"
    class="relative w-full py-20 px-6 md:px-12 lg:px-20 min-h-[60vh] text-white bg-[--dark-primary] overflow-hidden scroll-mt-16"
>
    <div class="relative z-10 max-w-7xl mx-auto">
        <SectionHeader
            heading="Our Solutions"
            description="From personal protection to corporate strategy, explore financial solutions designed to support you, your family, and your business."
        />

        <div class="mt-12 flex justify-center">
            <div
                class="flex flex-col sm:flex-row justify-center gap-4 w-full max-w-7xl"
                data-stagger-group
            >
                {
                    solutions.map((item) => (
                        <div class="scale-up relative rounded-2xl overflow-hidden group shadow-lg h-[400px] w-full">
                            {/* IMAGE */}
                            <Image
                                src={item.image}
                                alt={item.title}
                                class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                                widths={[480, 768, 1024]}
                                sizes="(max-width: 768px) 100vw, 50vw"
                            />

                            {/* GRADIENT */}
                            <div class="absolute inset-0 w-full h-full bg-gradient-to-t from-red-900/80 to-transparent" />

                            {/* TEXT */}
                            <div class="absolute bottom-0 left-0 w-full p-4 sm:p-5 z-10 flex flex-col gap-2">
                                <h3 class="text-base md:text-lg font-semibold">
                                    {item.title}
                                </h3>

                                <p class="text-white/70 text-sm">
                                    {item.description}
                                </p>

                                {/* BUTTON */}
                                <div class="mt-3">
                                    <Button
                                        href={item.href}
                                        id={item.btnId}
                                        variant="outline"
                                        size="sm"
                                    >
                                        Learn More
                                    </Button>
                                </div>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</section>
