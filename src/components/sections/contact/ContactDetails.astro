---
import {
    Card,
    CardContent,
    CardHeader,
    CardTitle,
    CardDescription,
    CardFooter,
} from "@/components/starwind/card";
import { tv } from "tailwind-variants";

/* ── Data ─────────────────────────────────────────────────── */
const primaryEmail = "plukchristelleanndeleon@gmail.com";
const partnershipsEmail = "maperaangpilipino@gmail.com";
const phoneNumber = "09617718678";
const phoneFormatted = "+63 961 771 8678";
const completeAddress =
    "Unit 2004, Antel Global Corporate Center, Doña Julia Vargas Avenue, Ortigas Center, San Antonio, Pasig City, 1605 Metro Manila, Philippines";
const facebookUrl = "https://www.facebook.com/share/1D8QNV1Vay/";
const tiktokUrl = "https://www.tiktok.com/@TheOnlyAnndeLeon";

const sectionStyles = tv({
    base: "@container py-20 px-6 md:px-12 lg:px-20 w-full items-center flex flex-col bg-[--dark-primary] text-white scroll-mt-20",
});
---

<section id="contact-details" class={sectionStyles()}>
    <div class="flex flex-col items-center w-full max-w-7xl">
        <!-- HEADER -->
        <div class="flex flex-col items-center text-center max-w-3xl">
            <h1
                class="font-heading text-4xl font-semibold tracking-tight @4xl:text-5xl text-[--secondary-color]"
            >
                Ways to Reach Us
            </h1>
            <p class="text-muted-foreground mt-6 text-lg max-w-2xl">
                Connect with our founder and advisory team directly through any
                of our official channels.
            </p>
        </div>

        <!-- CONTACT CARDS GRID -->
        <div
            class="w-full mt-12 grid gap-4 grid-cols-1 md:grid-cols-2 @2xl:grid-cols-3"
        >
            <!-- ═══════════ CARD 1: EMAIL ═══════════ -->
            <Card interactive>
                <CardContent class="flex flex-col gap-4">
                    <div class="flex gap-4 items-center">
                        <div
                            class="rounded-full bg-primary p-2.5 shadow-md shadow-primary/20 h-fit w-fit shrink-0"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="22"
                                height="22"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="text-primary-foreground"
                            >
                                <rect
                                    width="20"
                                    height="16"
                                    x="2"
                                    y="4"
                                    rx="2"></rect>
                                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"
                                ></path>
                            </svg>
                        </div>
                        <div class="font-medium text-xl">Email Addresses</div>
                    </div>
                    <blockquote class="text-muted-foreground leading-relaxed">
                        Drop us a line for general inquiries, personal
                        consultations, or strategic business collaborations.
                    </blockquote>

                    <!-- Email sub-cards -->
                    <div class="space-y-3 mt-2">
                        <div
                            class="rounded-xl border border-white/10 bg-black/20 p-4"
                        >
                            <div
                                class="flex items-center justify-between gap-2 mb-1"
                            >
                                <span
                                    class="text-xs uppercase tracking-wider text-white/50 font-medium"
                                >
                                    General & Inquiries
                                </span>
                                <button
                                    type="button"
                                    data-copy={primaryEmail}
                                    class="copy-btn text-white/60 hover:text-white transition flex items-center gap-1 text-xs cursor-pointer"
                                    title="Copy email"
                                >
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="14"
                                        height="14"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        class="copy-icon"
                                    >
                                        <rect
                                            width="14"
                                            height="14"
                                            x="8"
                                            y="8"
                                            rx="2"
                                            ry="2"></rect>
                                        <path
                                            d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"
                                        ></path>
                                    </svg>
                                    <span class="copy-label">Copy</span>
                                </button>
                            </div>
                            <a
                                href={`mailto:${primaryEmail}`}
                                class="text-sm font-medium text-white hover:text-[--secondary-color] transition break-all block"
                            >
                                {primaryEmail}
                            </a>
                        </div>

                        <div
                            class="rounded-xl border border-white/10 bg-black/20 p-4"
                        >
                            <div
                                class="flex items-center justify-between gap-2 mb-1"
                            >
                                <span
                                    class="text-xs uppercase tracking-wider text-[--secondary-color] font-medium"
                                >
                                    Collaborations & Partnerships
                                </span>
                                <button
                                    type="button"
                                    data-copy={partnershipsEmail}
                                    class="copy-btn text-white/60 hover:text-white transition flex items-center gap-1 text-xs cursor-pointer"
                                    title="Copy email"
                                >
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="14"
                                        height="14"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        class="copy-icon"
                                    >
                                        <rect
                                            width="14"
                                            height="14"
                                            x="8"
                                            y="8"
                                            rx="2"
                                            ry="2"></rect>
                                        <path
                                            d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"
                                        ></path>
                                    </svg>
                                    <span class="copy-label">Copy</span>
                                </button>
                            </div>
                            <a
                                href={`mailto:${partnershipsEmail}`}
                                class="text-sm font-medium text-white hover:text-[--secondary-color] transition break-all block"
                            >
                                {partnershipsEmail}
                            </a>
                        </div>
                    </div>
                </CardContent>
                <CardFooter>
                    <span class="text-xs text-white/40">
                        Typical response time: Within 24 hours
                    </span>
                </CardFooter>
            </Card>

            <!-- ═══════════ CARD 2: PHONE ═══════════ -->
            <Card interactive>
                <CardContent class="flex flex-col gap-4">
                    <div class="flex gap-4 items-center">
                        <div
                            class="rounded-full bg-primary p-2.5 shadow-md shadow-primary/20 h-fit w-fit shrink-0"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="22"
                                height="22"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="text-primary-foreground"
                            >
                                <path
                                    d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                                ></path>
                            </svg>
                        </div>
                        <div class="font-medium text-xl">Phone & Mobile</div>
                    </div>
                    <blockquote class="text-muted-foreground leading-relaxed">
                        Direct phone line available for urgent calls, SMS
                        inquiries, and consultation bookings.
                    </blockquote>

                    <!-- Phone detail -->
                    <div
                        class="rounded-xl border border-white/10 bg-black/20 p-5 mt-2"
                    >
                        <div
                            class="flex items-center justify-between gap-2 mb-2"
                        >
                            <span
                                class="text-xs uppercase tracking-wider text-white/50 font-medium"
                            >
                                Contact Number
                            </span>
                            <button
                                type="button"
                                data-copy={phoneNumber}
                                class="copy-btn text-white/60 hover:text-white transition flex items-center gap-1 text-xs cursor-pointer"
                                title="Copy phone number"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="14"
                                    height="14"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    class="copy-icon"
                                >
                                    <rect
                                        width="14"
                                        height="14"
                                        x="8"
                                        y="8"
                                        rx="2"
                                        ry="2"></rect>
                                    <path
                                        d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"
                                    ></path>
                                </svg>
                                <span class="copy-label">Copy</span>
                            </button>
                        </div>
                        <a
                            href={`tel:${phoneNumber}`}
                            class="text-2xl font-bold tracking-wide text-white hover:text-[--secondary-color] transition block"
                        >
                            {phoneFormatted}
                        </a>
                        <p class="text-xs text-white/50 mt-1">
                            Local mobile / Viber: {phoneNumber}
                        </p>
                    </div>

                    <!-- Hours badge -->
                    <div
                        class="rounded-xl border border-yellow-400/20 bg-yellow-400/5 p-4"
                    >
                        <p class="text-xs text-white/80 leading-relaxed">
                            Monday to Friday: 9:00 AM – 6:00 PM <br />
                            Weekend appointments upon request.
                        </p>
                    </div>
                </CardContent>
                <CardFooter>
                    <a
                        href={`tel:${phoneNumber}`}
                        class="inline-flex items-center gap-2 text-sm font-semibold text-[--secondary-color] hover:underline"
                    >
                        Call now
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="16"
                            height="16"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path
                                d="M15 3h6v6M10 14 21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"
                            ></path>
                        </svg>
                    </a>
                </CardFooter>
            </Card>

            <!-- ═══════════ CARD 3: SOCIAL PROFILES ═══════════ -->
            <Card interactive class="md:col-span-2 @2xl:col-span-1">
                <CardContent class="flex flex-col gap-4">
                    <div class="flex gap-4 items-center">
                        <div
                            class="rounded-full bg-primary p-2.5 shadow-md shadow-primary/20 h-fit w-fit shrink-0"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="22"
                                height="22"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="text-primary-foreground"
                            >
                                <circle cx="18" cy="5" r="3"></circle>
                                <circle cx="6" cy="12" r="3"></circle>
                                <circle cx="18" cy="19" r="3"></circle>
                                <line x1="8.59" x2="15.42" y1="13.51" y2="17.49"
                                ></line>
                                <line x1="15.41" x2="8.59" y1="6.51" y2="10.49"
                                ></line>
                            </svg>
                        </div>
                        <div class="font-medium text-xl">Social Profiles</div>
                    </div>
                    <blockquote class="text-muted-foreground leading-relaxed">
                        Stay updated with our latest financial literacy tips,
                        company highlights, and life milestones.
                    </blockquote>

                    <!-- Social links -->
                    <div class="space-y-3 mt-2">
                        <!-- Facebook -->
                        <a
                            href={facebookUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="flex items-center justify-between gap-4 p-4 rounded-xl border border-white/10 bg-black/20 hover:bg-white/10 transition group"
                        >
                            <div class="flex items-center gap-3.5">
                                <div
                                    class="w-10 h-10 rounded-xl bg-[#1877F2]/20 flex items-center justify-center text-[#1877F2] group-hover:scale-110 transition shrink-0"
                                >
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="20"
                                        height="20"
                                        viewBox="0 0 24 24"
                                        fill="currentColor"
                                    >
                                        <path
                                            d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
                                        ></path>
                                    </svg>
                                </div>
                                <div>
                                    <p
                                        class="text-sm font-semibold text-white group-hover:text-[--secondary-color] transition"
                                    >
                                        Facebook Community
                                    </p>
                                    <p class="text-xs text-white/50">
                                        Follow on Facebook
                                    </p>
                                </div>
                            </div>
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="16"
                                height="16"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="text-white/40 group-hover:text-white transition shrink-0"
                            >
                                <path
                                    d="M15 3h6v6M10 14 21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"
                                ></path>
                            </svg>
                        </a>

                        <!-- TikTok -->
                        <a
                            href={tiktokUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="flex items-center justify-between gap-4 p-4 rounded-xl border border-white/10 bg-black/20 hover:bg-white/10 transition group"
                        >
                            <div class="flex items-center gap-3.5">
                                <div
                                    class="w-10 h-10 rounded-xl bg-pink-500/20 flex items-center justify-center text-pink-400 group-hover:scale-110 transition shrink-0"
                                >
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="20"
                                        height="20"
                                        viewBox="0 0 24 24"
                                        fill="currentColor"
                                    >
                                        <path
                                            d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1v-3.5a6.37 6.37 0 0 0-.79-.05A6.34 6.34 0 0 0 3.15 15a6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.34-6.34V8.99a8.21 8.21 0 0 0 4.76 1.52V7.07a4.84 4.84 0 0 1-1-.38z"
                                        ></path>
                                    </svg>
                                </div>
                                <div>
                                    <p
                                        class="text-sm font-semibold text-white group-hover:text-[--secondary-color] transition"
                                    >
                                        @TheOnlyAnndeLeon
                                    </p>
                                    <p class="text-xs text-white/50">
                                        TikTok Channel
                                    </p>
                                </div>
                            </div>
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="16"
                                height="16"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="text-white/40 group-hover:text-white transition shrink-0"
                            >
                                <path
                                    d="M15 3h6v6M10 14 21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"
                                ></path>
                            </svg>
                        </a>
                    </div>
                </CardContent>
                <CardFooter>
                    <span class="text-xs text-white/40">
                        Active social community & educational content
                    </span>
                </CardFooter>
            </Card>
        </div>

        <!-- ═══════════ OFFICE & MAP (Full-width card) ═══════════ -->
        <div class="w-full mt-10">
            <Card class="overflow-hidden">
                <div class="grid grid-cols-1 lg:grid-cols-12">
                    <!-- Address details -->
                    <div
                        class="lg:col-span-5 p-6 sm:p-10 lg:p-12 flex flex-col justify-between border-b lg:border-b-0 lg:border-r border-white/10"
                    >
                        <div>
                            <div class="flex items-center gap-3 mb-6">
                                <div
                                    class="rounded-full bg-primary p-2.5 shadow-md shadow-primary/20 h-fit w-fit shrink-0"
                                >
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="22"
                                        height="22"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        class="text-primary-foreground"
                                    >
                                        <path
                                            d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"
                                        ></path>
                                        <path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"
                                        ></path>
                                        <path
                                            d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"
                                        ></path>
                                        <path d="M10 6h4"></path>
                                        <path d="M10 10h4"></path>
                                        <path d="M10 14h4"></path>
                                        <path d="M10 18h4"></path>
                                    </svg>
                                </div>
                                <div>
                                    <h3
                                        class="text-xl sm:text-2xl font-semibold"
                                    >
                                        Headquarters & Office
                                    </h3>
                                    <p class="text-white/50 text-sm">
