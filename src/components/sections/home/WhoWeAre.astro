---
import { tv } from "tailwind-variants";
import { Card, CardContent } from "@/components/starwind/card";
import CardHeader from "@/components/starwind/card/CardHeader.astro";

interface Props {
    heading?: string;
    body1?: string;
    body2?: string;
    achievements?: string[];
}

const movementStyles = tv({
    base: "@container w-full py-20 px-6 md:px-12 lg:px-20 flex flex-col items-center",
});

const { heading, body1, body2, achievements } = Astro.props;
---

<section class={movementStyles()}>
    <div
        class="w-full max-w-7xl grid gap-10 @3xl:grid-cols-5 @3xl:gap-12 items-stretch"
    >
        <div class="@3xl:col-span-3 flex flex-col justify-center gap-5">
            <h2
                class="font-heading text-3xl font-semibold tracking-tight leading-tight @2xl:text-4xl"
            >
                {heading}
            </h2>

            <p
                class="text-muted-foreground text-base leading-relaxed text-justify"
            >
                {body1}
            </p>
            <p
                class="text-muted-foreground text-base leading-relaxed text-justify"
            >
                {body2}
            </p>
        </div>

        <div class="@3xl:col-span-2 flex">
            <Card class="w-full border-none flex">
                <CardHeader class="text-2xl font-bold"
                    >Awards & Recognitions</CardHeader
                >
                <CardContent
                    class="flex flex-col justify-center gap-1 p-8 h-full relative"
                >
                    <ul
                        class="flex flex-col gap-0.5 text-left pl-2 list-disc text-lg"
                    >
                        {
                            achievements?.map((item, index) => {
                                return <li>{item}</li>;
                            })
                        }
                    </ul>
                </CardContent>
            </Card>
        </div>
    </div>
</section>
