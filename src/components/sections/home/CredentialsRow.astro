---
import Separator from "@/components/starwind/separator/Separator.astro";
---

<div
    id="credentials-row"
    class="flex gap-x-8 gap-y-4 flex-col sm:flex-row
                    text-center
                    bg-card/90 text-card-foreground px-10 py-8"
>
    <div class="flex flex-1 basis-0 flex-col justify-center items-center">
        <div class="flex count-clients" aria-hidden="true">
            <span class="font-bold text-5xl text-primary count-up"></span>
            <span class="font-bold text-5xl text-primary">+</span>
        </div>
        <span class="leading-none text-lg" aria-hidden="true"
            >clients guided</span
        >
        <span class="sr-only">Over 260 clients guided</span>
    </div>
    <Separator orientation="vertical" class="h-auto sm:block hidden" />
    <Separator class="sm:hidden block" />
    <div class="flex flex-1 basis-0 flex-col justify-center items-center">
        <div class="flex count-claims" aria-hidden="true">
            <span class="font-bold text-5xl text-primary">₱</span>
            <span class="font-bold text-5xl text-primary count-up"></span>
            <span class="font-bold text-5xl text-primary">M+</span>
        </div>
        <span class="leading-none text-lg" aria-hidden="true"
            >in claims managed</span
        >
        <span class="sr-only">Over 400 million pesos in claims managed</span>
    </div>
    <Separator orientation="vertical" class="h-auto sm:block hidden" />
    <Separator class="sm:hidden block" />
    <div
        class="flex flex-1 basis-0 flex-col justify-center items-center count-mentored"
    >
        <span
            class="font-bold text-5xl text-primary count-up"
            aria-hidden="true"></span>
        <span class="leading-none text-lg" aria-hidden="true">
            financial advisors mentored
        </span>
        <span class="sr-only">15 financial advisors mentored</span>
    </div>
</div>

<script>
    const row = document.getElementById("credentials-row");
    if (row) {
        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        row.classList.add("show");
                        observer.unobserve(row);
                    }
                });
            },
            { threshold: 0.2 },
        );
        observer.observe(row);
    }
</script>
