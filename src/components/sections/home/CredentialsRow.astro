---
import Separator from "@/components/starwind/separator/Separator.astro";
---

<div
    class="flex gap-x-8 gap-y-4 flex-col sm:flex-row
                    text-center
                    bg-card/90 text-card-foreground px-6 py-8"
>
    <div class="flex flex-1 basis-0 flex-col items-center">
        <span class="font-bold text-5xl text-primary">260+</span>
        <span class="leading-none text-lg">clients guided</span>
    </div>
    <Separator orientation="vertical" class="h-auto sm:block hidden" />
    <Separator class="sm:hidden block" />
    <div class="flex flex-1 basis-0 flex-col items-center">
        <span class="font-bold text-5xl text-primary">₱400M+</span>
        <span class="leading-none text-lg">in claims managed</span>
    </div>
    <Separator orientation="vertical" class="h-auto sm:block hidden" />
    <Separator class="sm:hidden block" />
    <div class="flex flex-1 basis-0 flex-col items-center">
        <span class="font-bold text-5xl text-primary">15</span>
        <span class="leading-none text-lg"> financial advisors mentored </span>
    </div>
</div>
