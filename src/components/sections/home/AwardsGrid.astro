---
import { Image } from "@/components/starwind/image";
import plukTeam from "@/assets/images/home/awards-grid/pluk team.jpg";
import changeOfAgent from "@/assets/images/home/awards-grid/change of agent.jpg";
import mrdtMeeting from "@/assets/images/home/awards-grid/mrdt meeting.jpg";
import mrdt from "@/assets/images/home/awards-grid/mrdt.jpg";
import natlAchiever from "@/assets/images/home/awards-grid/natl achiever.jpg";
import riseUp from "@/assets/images/home/awards-grid/rise up.jpg";
import thrivingBeyond from "@/assets/images/home/awards-grid/thriving beyond limits.jpg";
import topAgent from "@/assets/images/home/awards-grid/top agent.jpg";
import main from "@/assets/images/home/awards-grid/main-transparent.png";
import SectionWrapper from "../SectionWrapper.astro";
---

<SectionWrapper>
    <div class="max-w-7xl mx-auto flex flex-col items-center">
        <div
            id="awards-grid"
            data-custom-observer
            class="grid gap-4 md:grid-cols-4 grid-cols-2 grid-rows-6 *:rounded-xl *:overflow-hidden md:grid-rows-4 h-[1600px] md:h-[800px] w-full"
        >
            <div class="md:row-span-2 md:order-1 order-2 row-span-2 fade-up">
                <Image
                    src={natlAchiever}
                    alt="National Achiever Award"
                    class="object-cover h-full object-right"
                    widths={[480, 768, 1024]}
                    sizes="(max-width: 768px) 50vw, 25vw"
                />
            </div>
            <div class="order-3 md:order-2 fade-up">
                <Image
                    src={mrdt}
                    alt="MRDT Award"
                    class="object-cover h-full"
                    widths={[480, 768, 1024]}
                    sizes="(max-width: 768px) 50vw, 25vw"
                />
            </div>
            <div class="order-4 md:order-3 fade-up">
                <Image
                    src={topAgent}
                    alt="Top Agent Award"
                    class="object-cover h-full"
                    widths={[480, 768, 1024]}
                    sizes="(max-width: 768px) 50vw, 25vw"
                />
            </div>
            <div class="md:row-span-2 order-4 md:order-4 fade-up">
                <Image
                    src={changeOfAgent}
                    alt="Change of Agent Award"
                    class="object-cover h-full"
                    widths={[480, 768, 1024]}
                    sizes="(max-width: 768px) 50vw, 25vw"
                />
            </div>
            <div class="bg-card/90 md:row-span-2 col-span-2 order-1 md:order-5 fade-up">
                <div
                    class="@container w-full h-full flex items-center justify-center"
                >
                    <div
                        class="flex flex-col items-center justify-center w-3/5 text-foreground gap-4 px-4"
                    >
                        <div
                            class="flex flex-col gap-2 w-full
                        *:font-bold *:leading-none *:text-2xl @lg:*:text-4xl"
                        >
                            <span>
                                <span class="text-primary">Recognized</span> Nationally.
                            </span>
                            <span>
                                <span class="text-primary">Trusted</span> by 260+
                                families.
                            </span>
                        </div>
                        <div class="flex flex-col w-full">
                            <span class="text-xs underline"
                                >CHRISTELLE ANN DE LEON, CIA, CEPP</span
                            >
                            <span class="text-xs"
                                >LICENSED FINANCIAL ADVISOR</span
                            >
                            <span class="text-xs">JUNIOR UNIT MANAGER</span>
                        </div>
                    </div>
                    <Image
                        src={main}
                        alt="Christelle Ann De Leon Nationally Recognized"
                        class="object-cover h-full w-2/5 overflow-hidden @md:overflow-visible"
                        widths={[480, 768, 1024]}
                        sizes="50vw"
                    />
                </div>
            </div>
            <div class="md:row-span-2 order-8 md:order-6 fade-up">
                <Image
                    src={riseUp}
                    alt="Rise Up Award"
                    class="object-cover h-full"
                    widths={[480, 768, 1024]}
                    sizes="(max-width: 768px) 50vw, 25vw"
                />
            </div>
            <div class="order-6 md:order-7 fade-up">
                <Image
                    src={mrdtMeeting}
                    alt="MRDT Meeting"
                    class="object-cover h-full"
                    widths={[480, 768, 1024]}
                    sizes="(max-width: 768px) 50vw, 25vw"
                />
            </div>
            <div class="order-9 md:order-8 fade-up">
                <Image
                    src={thrivingBeyond}
                    alt="Thriving Beyond Limits Award"
                    class="object-cover h-full"
                    widths={[480, 768, 1024]}
                    sizes="(max-width: 768px) 50vw, 25vw"
                />
            </div>
            <div class="col-span-2 order-7 md:order-9 fade-up">
                <Image
                    src={plukTeam}
                    alt="PLUK Team"
                    class="object-cover h-full"
                    widths={[480, 768, 1024]}
                    sizes="(max-width: 768px) 100vw, 50vw"
                />
            </div>
        </div>
    </div>
</SectionWrapper>
<script>
    const imageContainers = document.querySelectorAll("#awards-grid > div");

    let pending: IntersectionObserverEntry[] = [];
    let timer: number | null = null;

    function processBatch() {
        timer = null;
        const batch = pending;
        pending = [];

        // Sort by visual position (top → bottom, left → right)
        batch.sort((a, b) => {
            const ra = a.boundingClientRect;
            const rb = b.boundingClientRect;
            if (Math.abs(ra.top - rb.top) > 10) return ra.top - rb.top;
            return ra.left - rb.left;
        });

        batch.forEach((entry, i) => {
            const el = entry.target as HTMLDivElement;
            el.style.transitionDelay = `${i * 0.2}s`;
            el.classList.add("show");
            observer.unobserve(el);
        });
    }

    const observer = new IntersectionObserver(
        (entries) => {
            for (const entry of entries) {
                if (entry.isIntersecting) pending.push(entry);
            }
            // Wait 50ms to collect all micro-batches, then process together
            if (pending.length && timer === null) {
                timer = window.setTimeout(processBatch, 50);
            }
        },
        { threshold: 0.1 },
    );
    imageContainers.forEach((el) => observer.observe(el));
</script>
