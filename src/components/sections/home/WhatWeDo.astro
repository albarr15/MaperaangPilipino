---
import SectionHeader from "@/components/header/SectionHeader";
import {
    CardHeader,
    CardTitle,
    CardDescription,
    CardFooter,
} from "@/components/starwind/card";
import Card from "@/components/starwind/card/Card.astro";
import Button from "@/components/starwind/button/Button.astro";

const services = [
    {
        header: "Personal / Individual Services",
        description:
            "Protect your family's future with life insurance, income protection, critical illness coverage, retirement planning, and more.",
        image: "/images/services/national-cancer-institute-xDSD3Vmzh70-unsplash.jpg",
        list: [
            "Family Protection",
            "Retirement Planning",
            "Education Funding",
            "Estate Planning",
            "Legacy Savings",
            "Mortgage Redemption Insurance",
            "Short to Long Term Investments Planning",
            "Income Protection / Replacement",
            "Critical Illness Funding / Protection",
        ],
    },
    {
        header: "Organization / Corporate Services",
        description:
            "Safeguard your business with employee benefits, executive protection, keyman insurance, and corporate investment strategies.",
        image: "/images/services/photo-1508385082359-f38ae991e8f2.avif",
        list: [
            "Employment Benefits",
            "Corporate Investments",
            "Employee Retirement Funder",
            "Enhancement of Current Medical Benefits",
            "Executive Benefits / Keyman Insurance",
            "Business Protection (Buy-Sell Agreement)",
        ],
    },
];
---

<section class="w-full py-20 px-6 md:px-12 lg:px-20">
    <div class="max-w-7xl mx-auto text-center">
        <SectionHeader
            title="Our Services"
            description="We provide high-quality digital solutions to help businesses grow,
          innovate, and scale efficiently."
            align="center"
            color="yellow"
        />

        <div class="mt-14 flex justify-center">
            <div
                class="grid grid-cols-1 md:grid-cols-2 items-start mx-auto gap-8 max-w-7xl"
            >
                {
                    services.map((service, index) => {
                        return (
                            <Card class="relative max-w-lg" data-service-card>
                                <img
                                    src={service.image}
                                    alt={service.header}
                                    class="aspect-video w-full object-cover"
                                />
                                <CardHeader>
                                    <CardTitle class="font-bold">
                                        {service.header}
                                    </CardTitle>
                                    <CardDescription>
                                        <div class="flex flex-col gap-8 items-start">
                                            <span class="text-justify">
                                                {service.description}
                                            </span>
                                            <ul class="grid grid-cols-2 gap-4 text-left list-disc pl-5">
                                                {service.list.map(
                                                    (item, index) => {
                                                        return <li>{item}</li>;
                                                    },
                                                )}
                                            </ul>
                                        </div>
                                    </CardDescription>
                                </CardHeader>
                                <CardFooter>
                                    <Button class="w-full" data-view-btn>
                                        View All
                                    </Button>
                                </CardFooter>
                            </Card>
                        );
                    })
                }
            </div>
        </div>
    </div>
</section>

<script>
    document
        .querySelectorAll<HTMLElement>("[data-service-card]")
        .forEach((card, index) => {
            const btn =
                card.querySelector<HTMLButtonElement>("[data-view-btn]");
            if (!btn) return;

            btn.addEventListener("click", () => {
                const url =
                    index === 0
                        ? "/services#personal-insurance"
                        : "/services#corporate-insurance";
                window.location.href = url;
            });
        });
</script>
