---
import SectionHeader from "@/components/header/SectionHeader.astro";
import Button from "@/components/starwind/button/Button.astro";
import SectionWrapper from "../SectionWrapper.astro";
import ctaImg from "@/assets/images/home/family.jpg";
import { Image } from "astro:assets";
---

<SectionWrapper>
    <div
        class="relative max-w-5xl mx-auto rounded-2xl shadow-xl p-8 overflow-hidden"
    >
        <div class="absolute inset-0 z-10 overflow-hidden">
            <div class="absolute inset-0 bg-primary/20"></div>

            <Image
                src={ctaImg}
                alt="background"
                class="w-full h-full object-cover opacity-20"
                widths={[640, 1024, 1536]}
                sizes="100vw"
            />
        </div>
        <div class="relative z-20">
            <SectionHeader
                class="!mb-0"
                heading="Protect What Matters Most"
                description="Take the first step toward lasting peace of mind. I'm here to help you find the right protection for the people who matter most."
            />
            <div
                class="flex flex-col sm:flex-row justify-center gap-4 mt-8 sm:mt-16 scale-up"
            >
                <Button
                    href="/consultation"
                    class="flex items-center gap-2 backdrop-blur-md"
                    variant="primary"
                >
                    Book Consultation
                </Button>
            </div>
        </div>
    </div>
</SectionWrapper>
