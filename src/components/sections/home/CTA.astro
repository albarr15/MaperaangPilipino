---
import SectionHeader from "@/components/header/SectionHeader.astro";
import Button from "@/components/starwind/button/Button.astro";
import SectionWrapper from "../SectionWrapper.astro";
import ctaImg from "@/assets/images/home/family.jpg";
import { Image } from "astro:assets";
---

<SectionWrapper>
    <div
        class="relative max-w-5xl mx-auto rounded-2xl ring-1 ring-white/80 p-8 overflow-hidden"
    >
        <div class="absolute inset-0 z-10">
            <Image
                src={ctaImg}
                alt="background"
                class="w-full h-full object-cover opacity-50 grayscale"
                widths={[640, 1024, 1536]}
                sizes="100vw"
            />
        </div>
        <div class="relative z-20">
            <SectionHeader
                title="Secure Your Future Today"
                description="Don't leave your family's future to chance. Take action now and build the secure, prosperous life you deserve."
                align="center"
                color="yellow"
                size="xl"
            />
            <div
                class="flex flex-col sm:flex-row justify-center gap-4 mt-12 sm:mt-24"
            >
                <Button
                    href="/consultation"
                    class="flex items-center gap-2 backdrop-blur-md"
                >
                    Book Consultation
                </Button>
            </div>
        </div>
    </div>
</SectionWrapper>
