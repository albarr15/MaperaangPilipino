---
import SectionHeader from "@/components/header/SectionHeader.astro";
import { Card, CardContent } from "@/components/starwind/card";
import Separator from "@/components/starwind/separator/Separator.astro";
import { Image } from "astro:assets";
import founderImg from "@/assets/images/about/Meet Ann.png";
import CredentialsRow from "../home/CredentialsRow.astro";
---

<section
    class="relative w-full py-20 px-6 md:px-12 lg:px-20 min-h-[60vh] text-white overflow-hidden"
    id="founder"
>
    <div class="relative z-10 max-w-7xl mx-auto">
        <SectionHeader heading="Meet Ann" />
    </div>

    <div
        class="mt-4 mx-auto grid max-w-6xl grid-cols-1 md:grid-cols-5 gap-8 md:gap-10 items-center"
    >
        <div class="md:col-span-2 md:h-full">
            <div
                class="scale-up aspect-[4/3] md:aspect-[3/4] overflow-hidden rounded-xl"
            >
                <Image
                    src={founderImg}
                    alt="Christelle Ann De Leon"
                    widths={[480, 768, 1024]}
                    sizes="(max-width: 768px) 100vw, 50vw"
                    class="size-full object-cover object-top"
                />
            </div>
        </div>

        <div
            class="md:col-span-3 flex flex-col justify-center gap-4"
            data-stagger-group
        >
            <h2 class="scale-up text-2xl md:text-4xl font-bold">
                Christelle Ann de Leon, CIA, CEPP
            </h2>

            <div class="fade-up flex flex-col gap-2 leading-none">
                <span
                    >Bachelor of Arts in Theater Arts - Major in Direction and
                    Performance</span
                >
                <ul class="list-disc list-inside flex flex-col gap-2 ml-4">
                    <li>Junior Unit Manager at Pru Life UK</li>
                    <li>Licensed Financial Advisor</li>
                    <li>Million Dollar Round Table Runner</li>
                </ul>
            </div>
            <Separator class="fade-up mb-4" />

            <div
                class="text-white/70 text-sm md:text-base leading-relaxed space-y-4 text-justify"
                data-stagger-group
            >
                <p class="fade-up">
                    My career didn't start in finance. It started on stage,
                    where I worked as a production manager, costume designer,
                    performer, and entrepreneur running my own events business,
                    with <span class="text-yellow-200">creativity</span> at the heart
                    of everything I did.
                </p>

                <p class="fade-up">
                    When the 2020 pandemic brought the entertainment industry to
                    a halt, I needed a new path, one that offered flexibility
                    without dimming my drive to build something meaningful. I
                    came across the opportunity through a former classmate
                    already working in the industry, and after learning more
                    about <span class="text-yellow-200">Pru Life UK</span>'s
                    culture of financial education, professional training, and
                    growth, I decided to make the shift. I earned <span
                        class="text-yellow-200">Top 1 Rookie of the Year</span
                    > in my first year and went on to qualify for the <span
                        class="text-yellow-200">Early Achiever Club</span
                    > for five consecutive years, a distinction held by only the top
                    10% of financial advisors nationwide.
                </p>

                <p class="fade-up">
                    Today, as a <span class="text-yellow-200"
                        >Junior Unit Manager</span
                    > and mother of two, I bring the same creativity and purpose that
                    defined my early career into my work protecting Filipino families
                    and helping them build brighter, more secure futures.
                </p>
            </div>
        </div>
    </div>

    <Card class="mx-auto w-full max-w-3xl mt-12 px-4 sm:px-8 scale-up">
        <CardContent>
            <CredentialsRow layout="card" />
        </CardContent>
    </Card>
</section>
