---
import SectionHeader from "@/components/header/SectionHeader";
import { CardContent } from "@/components/starwind/card";
import Card from "@/components/starwind/card/Card.astro";
import Separator from "@/components/starwind/separator/Separator.astro";
---

<section
    id="mission"
    class="relative w-full py-20 px-6 md:px-12 lg:px-20 min-h-[60vh] text-white bg-[--dark-primary] overflow-hidden"
>
    <div class="relative z-10 max-w-7xl mx-auto">
        <SectionHeader
            title="Our Mission"
            description="To nurture future financial professionals while empowering Filipino families through education, protection, and long-term financial planning."
            align="center"
            size="xl"
            color="yellow"
        />

        <div class="mt-12 w-full overflow-hidden rounded-2xl shadow-lg">
            <div class="flex w-max animate-marquee">
                <img
                    src="/partials/pru-gallery.png"
                    alt="Pru Life UK Gallery"
                    class="h-[20rem] w-auto max-w-none"
                />
                <img
                    src="/partials/pru-gallery.png"
                    alt="Pru Life UK Gallery"
                    class="h-[20rem] w-auto !max-w-none"
                    aria-hidden="true"
                />
            </div>
        </div>
        <Card class="mx-auto w-full max-w-3xl mt-12 px-4 sm:px-8">
            <CardContent>
                <div
                    class="flex gap-x-8 gap-y-4 flex-col sm:flex-row
                    text-center sm:mt-2 mt-0"
                >
                    <div class="flex flex-1 basis-0 flex-col items-center">
                        <span class="font-bold text-primary text-4xl">260+</span
                        >
                        <span class="leading-none text-sm">clients guided</span>
                    </div>
                    <Separator
                        orientation="vertical"
                        class="bg-primary h-auto sm:block hidden"
                    />
                    <Separator class="bg-primary sm:hidden block" />
                    <div class="flex flex-1 basis-0 flex-col items-center">
                        <span class="font-bold text-primary text-4xl"
                            >₱400M+</span
                        >
                        <span class="leading-none text-sm"
                            >in claims managed</span
                        >
                    </div>
                    <Separator
                        orientation="vertical"
                        class="bg-primary h-auto sm:block hidden"
                    />
                    <Separator class="bg-primary sm:hidden block" />
                    <div class="flex flex-1 basis-0 flex-col items-center">
                        <span class="font-bold text-primary text-4xl">15</span>
                        <span class="leading-none text-sm"
                            >financial advisors mentored</span
                        >
                    </div>
                </div>
            </CardContent>
        </Card>
    </div>
</section>
