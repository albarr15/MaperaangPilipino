import { Medal, Star, TrendingUp, Trophy } from "lucide-react";
import MDRTLogo from "@/assets/images/about/mdrt-logo.png";
const content = [
    {
        title: "Million Dollar Round Table Runner",
        year: "2026",
        source: ["Pru Life UK"],
        icon: MDRTLogo,
    },
    {
        title: "BOSLIA Top Agent",
        year: "2026",
        icon: Star,
        source: ["Black Orcas Summit Life Insurance Agency"],
    },
    {
        title: "Promoted to Junior Unit Manager",
        year: "2025",
        icon: TrendingUp,
        source: ["Pru Life UK"],
    },
    {
        title: "National Achiever Club Qualifier",
        year: "2021 - 2026",
        icon: Medal,
        source: ["Pru Life UK"],
        badge: "6-year streak",
    },

    {
        title: "Million Producers Club Qualifier",
        year: "2022 - 2025",
        icon: Medal,
        source: ["Pru Life UK", "Blue Fox Summit Life Insurance Agency"],
        badge: "4-year streak",
    },
    {
        title: "Early Achiever Club Qualifier",
        subtitle: "(Belongs to Top 10% of Financial Advisors Nationwide)",
        year: "2021 - 2025",
        icon: Medal,
        source: ["Pru Life UK"],
        badge: "5-year streak",
    },
    {
        title: "Top 1 Business Builder of the Year (Unit)",
        year: "2023",
        icon: Trophy,
        source: ["Pru Life UK"],
    },
    {
        title: "Promoted to Associate Unit Manager",
        year: "2022",
        icon: TrendingUp,
        source: ["Pru Life UK"],
    },
    {
        title: "Top 1 Rookie of the Year (Unit)",
        year: "2021",
        icon: Trophy,
        source: ["Pru Life UK"],
    },
];
---

<SectionWrapper>
    <AwardsGridSection
        heading="Awards & Recognition"
        description="Milestones earned through years of proven performance."
        content={content}
        id="awards"
    />
</SectionWrapper>
